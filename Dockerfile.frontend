FROM node:20-alpine AS build
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY index.html vite.config.js eslint.config.js ./
COPY src ./src

ARG VITE_BACKEND_URL
ARG VITE_API_BASE_URL
ARG VITE_FHIR_PROVIDER=oracle
ARG VITE_FHIR_STREAM_URL
ARG VITE_DEBUG_FHIR_STREAM=true
ARG VITE_FHIR_PATIENT_ID=
ARG VITE_WAVEFORM_STREAM_URL
ARG VITE_ENABLE_SLM_EVAL=true
ARG VITE_EVALUATION_BASE_WAVEFORM_SOURCE=api_range
ARG VITE_ESCALATION_POLL_MS=2000
ARG VITE_ESCALATION_COUNTDOWN_TICK_MS=1000

ENV VITE_BACKEND_URL=$VITE_BACKEND_URL \
    VITE_API_BASE_URL=$VITE_API_BASE_URL \
    VITE_FHIR_PROVIDER=$VITE_FHIR_PROVIDER \
    VITE_FHIR_STREAM_URL=$VITE_FHIR_STREAM_URL \
    VITE_DEBUG_FHIR_STREAM=$VITE_DEBUG_FHIR_STREAM \
    VITE_FHIR_PATIENT_ID=$VITE_FHIR_PATIENT_ID \
    VITE_WAVEFORM_STREAM_URL=$VITE_WAVEFORM_STREAM_URL \
    VITE_ENABLE_SLM_EVAL=$VITE_ENABLE_SLM_EVAL \
    VITE_EVALUATION_BASE_WAVEFORM_SOURCE=$VITE_EVALUATION_BASE_WAVEFORM_SOURCE \
    VITE_ESCALATION_POLL_MS=$VITE_ESCALATION_POLL_MS \
    VITE_ESCALATION_COUNTDOWN_TICK_MS=$VITE_ESCALATION_COUNTDOWN_TICK_MS

RUN npm run build

FROM nginx:1.27-alpine
COPY nginx.frontend.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
